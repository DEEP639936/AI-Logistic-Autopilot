# SQLite file (default: backend/data/app.db — created and seeded on first boot)
DATABASE_PATH=

# Optional LLM for the copilot (any OpenAI-compatible endpoint).
# Without it the copilot answers deterministically and is labelled rule_based.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Business-rule template (defaults to config/ai_logistics_thresholds.yaml)
THRESHOLDS_YAML=
